<mxfile host="app.diagrams.net" agent="Mozilla/5.0">
  <diagram id="seq_diagram_propellants" name="Диаграмма последовательности (8 операций)">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Диаграмма последовательности (Sequence Diagram) - 8 операций со связью через signature" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#111111;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="15" width="1020" height="30" as="geometry" />
        </mxCell>

        <!-- LIFELINES -->
        <mxCell id="ll_user" value="Пользователь" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.5;fontColor=#111111;participant=umlActor;" vertex="1" parent="1">
          <mxGeometry x="70" y="55" width="80" height="800" as="geometry" />
        </mxCell>

        <mxCell id="ll_front" value="SPA Фронтенд" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.5;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="210" y="55" width="120" height="800" as="geometry" />
        </mxCell>

        <mxCell id="ll_auth" value="Домен пользователей&#xa;(AuthService)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.5;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="400" y="55" width="150" height="800" as="geometry" />
        </mxCell>

        <mxCell id="ll_prop" value="Домен видов топлива&#xa;(PropellantsService)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.5;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="620" y="55" width="160" height="800" as="geometry" />
        </mxCell>

        <mxCell id="ll_redis" value="Redis&#xa;(Session Store)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.5;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="845" y="55" width="110" height="800" as="geometry" />
        </mxCell>

        <mxCell id="ll_db" value="PostgreSQL&#xa;(Database)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.5;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="1015" y="55" width="110" height="800" as="geometry" />
        </mxCell>

        <!-- OPERATION 1: POST UserLogin() -->
        <mxCell id="m1_user_front" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#222222;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;" value="Ввод логина и пароля">
          <mxGeometry relative="1" as="geometry"><mxPoint x="110" y="130" as="sourcePoint" /><mxPoint x="270" y="130" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m1_front_auth" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0055aa;strokeWidth=1.5;fontFamily=Consolas;fontSize=11.5;fontStyle=1;fontColor=#003388;" value="1: POST UserLogin()">
          <mxGeometry relative="1" as="geometry"><mxPoint x="270" y="145" as="sourcePoint" /><mxPoint x="475" y="145" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m1_auth_redis" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;strokeColor=#444444;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="SET session:UUID { userId, role } (TTL 24h)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="475" y="160" as="sourcePoint" /><mxPoint x="900" y="160" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m1_auth_front_ret" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#222222;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="Set-Cookie: sessionId=UUID (HttpOnly), 200 OK">
          <mxGeometry relative="1" as="geometry"><mxPoint x="475" y="180" as="sourcePoint" /><mxPoint x="270" y="180" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- OPERATION 2: GET Propellants(maxMolarMass) -->
        <mxCell id="m2_front_prop" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0055aa;strokeWidth=1.5;fontFamily=Consolas;fontSize=11.5;fontStyle=1;fontColor=#003388;" value="2: GET Propellants(maxMolarMass)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="270" y="215" as="sourcePoint" /><mxPoint x="700" y="215" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2_prop_db" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;strokeColor=#444444;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="SELECT WHERE status='published' AND molar_mass &lt;= max">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="230" as="sourcePoint" /><mxPoint x="1070" y="230" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2_prop_front_ret" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#222222;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="200 OK: PropellantResponseDto[] (каталог без авторизации)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="250" as="sourcePoint" /><mxPoint x="270" y="250" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- OPERATION 3: GET PropellantFeed(id, next) -->
        <mxCell id="m3_front_prop" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0055aa;strokeWidth=1.5;fontFamily=Consolas;fontSize=11.5;fontStyle=1;fontColor=#003388;" value="3: GET PropellantFeed(id, next)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="270" y="285" as="sourcePoint" /><mxPoint x="700" y="285" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m3_prop_db" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;strokeColor=#444444;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="SELECT WHERE id &gt; current_id ORDER BY id ASC LIMIT 1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="300" as="sourcePoint" /><mxPoint x="1070" y="300" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m3_prop_front_ret" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#222222;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="200 OK: PropellantResponseDto (следующая карточка в ленте)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="320" as="sourcePoint" /><mxPoint x="270" y="320" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- OPERATION 4: GET PropellantDraft() -->
        <mxCell id="m4_front_prop" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0055aa;strokeWidth=1.5;fontFamily=Consolas;fontSize=11.5;fontStyle=1;fontColor=#003388;" value="4: GET PropellantDraft()">
          <mxGeometry relative="1" as="geometry"><mxPoint x="270" y="355" as="sourcePoint" /><mxPoint x="700" y="355" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4_prop_redis" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;strokeColor=#444444;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="AuthGuard: проверка cookie sessionId">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="370" as="sourcePoint" /><mxPoint x="900" y="370" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4_prop_db" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;strokeColor=#444444;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="SELECT WHERE creator_id = user.id AND status='draft'">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="390" as="sourcePoint" /><mxPoint x="1070" y="390" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4_prop_front_ret" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#222222;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="200 OK: поля черновика текущего пользователя">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="410" as="sourcePoint" /><mxPoint x="270" y="410" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- OPERATION 5: POST Propellant(name, image, video) -->
        <mxCell id="m5_front_prop" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0055aa;strokeWidth=1.5;fontFamily=Consolas;fontSize=11.5;fontStyle=1;fontColor=#003388;" value="5: POST Propellant(name, image, video)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="270" y="445" as="sourcePoint" /><mxPoint x="700" y="445" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5_prop_redis" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;strokeColor=#444444;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="Автозаполнение creator_id = session.userId">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="460" as="sourcePoint" /><mxPoint x="900" y="460" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5_prop_db" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;strokeColor=#444444;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="INSERT INTO propellants (name, status='draft', creator_id)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="480" as="sourcePoint" /><mxPoint x="1070" y="480" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5_prop_front_ret" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#222222;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="201 Created: PropellantResponseDto">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="500" as="sourcePoint" /><mxPoint x="270" y="500" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- OPERATION 6: PUT Propellant(id) -->
        <mxCell id="m6_front_prop" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0055aa;strokeWidth=1.5;fontFamily=Consolas;fontSize=11.5;fontStyle=1;fontColor=#003388;" value="6: PUT Propellant(id)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="270" y="535" as="sourcePoint" /><mxPoint x="700" y="535" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6_prop_redis" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;strokeColor=#444444;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="Без cookie -&gt; 401 Unauthorized; С cookie -&gt; проверка прав создателя">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="550" as="sourcePoint" /><mxPoint x="900" y="550" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6_prop_db" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;strokeColor=#444444;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="UPDATE propellants SET name, molar_mass, updated_at">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="570" as="sourcePoint" /><mxPoint x="1070" y="570" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6_prop_front_ret" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#222222;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="200 OK: запись с измененными полями">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="590" as="sourcePoint" /><mxPoint x="270" y="590" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- OPERATION 7: DELETE Propellant(id) -->
        <mxCell id="m7_front_prop" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0055aa;strokeWidth=1.5;fontFamily=Consolas;fontSize=11.5;fontStyle=1;fontColor=#003388;" value="7: DELETE Propellant(id)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="270" y="625" as="sourcePoint" /><mxPoint x="700" y="625" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m7_prop_db" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;strokeColor=#444444;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="UPDATE propellants SET status='deleted' (Soft Delete)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="640" as="sourcePoint" /><mxPoint x="1070" y="640" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m7_prop_front_ret" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#222222;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="200 OK: { success: true }">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="660" as="sourcePoint" /><mxPoint x="270" y="660" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- OPERATION 8: POST PropellantLike(id, like) -->
        <mxCell id="m8_front_prop" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0055aa;strokeWidth=1.5;fontFamily=Consolas;fontSize=11.5;fontStyle=1;fontColor=#003388;" value="8: POST PropellantLike(id, like)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="270" y="695" as="sourcePoint" /><mxPoint x="700" y="695" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m8_prop_db" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;strokeColor=#444444;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="INSERT / DELETE propellant_likes (user_id, propellant_id)">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="710" as="sourcePoint" /><mxPoint x="1070" y="710" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m8_prop_front_ret" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#222222;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10.5;" value="200 OK: { success: true, liked: 1, likes_count: N }">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="730" as="sourcePoint" /><mxPoint x="270" y="730" as="targetPoint" /></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>