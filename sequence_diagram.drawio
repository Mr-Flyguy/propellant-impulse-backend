<mxfile host="app.diagrams.net" agent="Mozilla/5.0">
  <diagram id="seq_diagram_http" name="HTTP запросы">
    <mxGraphModel dx="1200" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="1140" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

