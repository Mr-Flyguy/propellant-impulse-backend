          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "propellants", "feed"],
          "query": [
            {
              "key": "id",
              "value": "1",
              "description": "ID текущей просматриваемой услуги"
            },
            {
              "key": "next",
              "value": "true",
              "description": "Флаг циклического перехода к следующей услуге"
            }
          ]
        },
        "description": "Скриншот 5: Получение услуги из ленты по ID с флагом перехода next=true."
      },
      "response": []
    },
