<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Расчет импульса ЯРД // Каталог</title>
  <link rel="stylesheet" href="/css/propellant-bwxt.css">
</head>
<body>
  <div class="mobile-app-frame">
    <div class="page-content-scrollable">
      <div class="screen-header-block">
        <h1 class="screen-title">Рабочие тела ЯРД</h1>
        <p class="screen-subtitle">Реестр компонентов</p>
      </div>

      <div class="catalog-filter-bar">
        <form method="GET" action="/propellants/catalog" class="filter-form-slider">
          <div class="slider-meta-row">
            <span class="slider-range-label">Диапазон: 1.00–64.00</span>
            <span class="slider-current-value" id="sliderValDisplay">{{filter_max_molar_mass}}</span>
          </div>
          <div class="slider-input-container">
            <input type="range" min="1.00" max="64.00" step="0.01" name="max_molar_mass"
              value="{{filter_max_molar_mass}}" class="filter-range-slider" id="molarMassSlider"
              oninput="document.getElementById('sliderValDisplay').innerText = parseFloat(this.value).toFixed(2)">
          </div>
          <button type="submit" class="btn-filter-submit-block">Фильтр</button>
        </form>
      </div>

      <div class="catalog-cards-grid">
        {{#each propellants}}
        <div class="propellant-card-wrapper">
          <a href="/propellants/feed/{{this.id}}" class="propellant-grid-card">
            <div class="card-image-box">
              <img src="{{this.imageUrl}}" alt="{{this.name}}" class="propellant-card-img" loading="lazy">
            </div>
            <div class="card-meta-content">
              <div class="card-propellant-title">{{this.name}}{{#if this.chemicalFormula}} {{this.chemicalFormula}}{{/if}}</div>
              <div class="card-bottom-row">
                <span class="card-molar-mass">{{this.molarMass}} г/моль</span>
                <span class="card-likes-count">
                  <span class="card-heart-icon">&hearts;</span> {{this.likesCount}}
                </span>
              </div>
            </div>
          </a>
          <form method="POST" action="/propellants/delete/{{this.id}}" class="card-delete-form">
            <button type="submit" class="btn-card-delete" title="Удалить">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
            </button>
          </form>
        </div>
        {{/each}}
      </div>
    </div>

    <nav class="bottom-tab-bar">
      <a href="/propellants/feed" class="tab-nav-item">
        <svg class="tab-nav-svg" viewBox="0 0 24 24">
          <path d="M12 2c-3.5 4-6 7.5-6 11a6 6 0 0 0 12 0c0-3.5-2.5-7-6-11z" />
          <path d="M12 18a2.5 2.5 0 0 1-2.5-2.5c0-1.5 1.5-2.5 2.5-4 1 1.5 2.5 2.5 2.5 4a2.5 2.5 0 0 1-2.5 2.5z" />
        </svg>
        <span>ЛЕНТА</span>
      </a>
      <a href="/propellants/draft" class="tab-nav-item">
        <svg class="tab-nav-svg" viewBox="0 0 24 24">
          <line x1="12" y1="5" x2="12" y2="19" />
          <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        <span>ДОБАВИТЬ</span>
      </a>
      <a href="/propellants/catalog" class="tab-nav-item active">
        <div class="tab-active-indicator"></div>
        <svg class="tab-nav-svg" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="3" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="12" y1="3" x2="12" y2="21" />
        </svg>
        <span>ПЛИТКА</span>
      </a>
    </nav>
  </div>
</body>
</html>