<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Расчет импульса ЯРД // Лента</title>
  <link rel="stylesheet" href="/css/propellant-bwxt.css">
</head>
<body>
  <div class="mobile-app-frame">
    <div class="feed-viewport">
      <video class="feed-bg-video" autoplay loop muted playsinline preload="auto">
        <source src="{{propellant.videoUrl}}" type="video/mp4">
      </video>
      <div class="feed-scrim-overlay"></div>

      <div class="feed-system-tag">ЛЕНТА ЭЛЕМЕНТОВ</div>

      <div class="feed-actions-stack">
        <div class="feed-like-group">
          <div class="action-atom-btn" title="Одобрено инженерами">
            <svg class="action-atom-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="2.5" fill="currentColor"/>
              <circle cx="7.5" cy="7.5" r="3"/>
              <circle cx="16.5" cy="7.5" r="3"/>
              <circle cx="16.5" cy="16.5" r="3"/>
              <circle cx="7.5" cy="16.5" r="3"/>
            </svg>
          </div>
          <span class="action-like-counter">{{propellant.likesCount}}</span>
        </div>

        <div class="feed-action-pill">M = {{propellant.molarMass}} г/моль</div>
        <div class="feed-action-pill">Isp = {{propellant.specificImpulse}} с</div>

        <a href="/propellants/feed/{{next_id}}" class="btn-next-feed">Далее &gt;</a>
      </div>

      <div class="feed-info-card">
        <h1 class="feed-title">{{propellant.name}}{{#if propellant.chemicalFormula}} ({{propellant.chemicalFormula}}){{/if}}</h1>

        <p class="desc-short-preview">{{propellant.shortDescription}}</p>

        <details class="desc-details">
          <summary>Подробнее &#9662;</summary>
          <p class="desc-full-text">{{propellant.engineeringAnalysis}}</p>
        </details>
      </div>
    </div>

    <nav class="bottom-tab-bar">
      <a href="/propellants/feed" class="tab-nav-item active">
        <div class="tab-active-indicator"></div>
        <svg class="tab-nav-svg" viewBox="0 0 24 24">
          <path d="M12 2c-3.5 4-6 7.5-6 11a6 6 0 0 0 12 0c0-3.5-2.5-7-6-11z"/>
          <path d="M12 18a2.5 2.5 0 0 1-2.5-2.5c0-1.5 1.5-2.5 2.5-4 1 1.5 2.5 2.5 2.5 4a2.5 2.5 0 0 1-2.5 2.5z"/>
        </svg>
        <span>ЛЕНТА</span>
      </a>
      <a href="/propellants/draft" class="tab-nav-item">
        <svg class="tab-nav-svg" viewBox="0 0 24 24">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        <span>ДОБАВИТЬ</span>
      </a>
      <a href="/propellants/catalog" class="tab-nav-item">
        <svg class="tab-nav-svg" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="3"/>
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="12" y1="3" x2="12" y2="21" />
        </svg>
        <span>ПЛИТКА</span>
      </a>
    </nav>
  </div>
</body>
</html>
