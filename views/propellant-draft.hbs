<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Расчет импульса ЯРД // Черновик</title>
  <link rel="stylesheet" href="/css/propellant-bwxt.css">
</head>
<body>
  <div class="mobile-app-frame">
    <div class="page-content-scrollable">
      {{#if has_draft}}
      <div class="screen-header-block">
        <div class="screen-title-row">
          <h1 class="screen-title">Черновик тела</h1>
          <span class="badge-draft-pill">ЧЕРНОВИК</span>
        </div>
        <p class="screen-subtitle">Заполните термодинамические характеристики и опубликуйте спецификацию рабочего тела.</p>
      </div>

      <form method="POST" action="/propellants/publish" class="draft-form-block">
        <div class="section-caption-red">МЕДИАФАЙЛЫ</div>

        <div class="media-preview-card">
          <img src="{{#if draft_propellant.imageUrl}}{{draft_propellant.imageUrl}}{{else}}/img/default_propellant.jpg{{/if}}"
               class="media-preview-thumb" alt="{{draft_propellant.name}}"
               onerror="this.src='/img/default_propellant.jpg'">
          <div class="media-preview-meta">
            <div class="media-preview-name">{{draft_propellant.name}}</div>
            <div class="media-preview-specs">Медиафайлы прикреплены</div>
          </div>
        </div>

        <input type="hidden" name="image_url" value="{{#if draft_propellant.imageUrl}}{{draft_propellant.imageUrl}}{{else}}/img/default_propellant.jpg{{/if}}">
        <input type="hidden" name="video_url" value="{{#if draft_propellant.videoUrl}}{{draft_propellant.videoUrl}}{{else}}/video/default_exhaust.mp4{{/if}}">

        <div class="section-caption-red">ХАРАКТЕРИСТИКИ ПО ТЕМЕ</div>

        <div class="form-group-block">
          <label class="input-caption-label">НАЗВАНИЕ *</label>
          <input type="text" name="name" class="form-input-control" value="{{draft_propellant.name}}" required>
        </div>

        <div class="form-group-block">
          <label class="input-caption-label">МОЛЯРНАЯ МАССА (Г/МОЛЬ) *</label>
          <input type="text" name="molar_mass" class="form-input-control" value="{{draft_propellant.molarMass}}" placeholder="16,04" required>
        </div>

        <div class="form-group-block">
          <label class="input-caption-label">ПОКАЗАТЕЛЬ АДИАБАТЫ (Г) *</label>
          <input type="text" name="specific_heat_ratio" class="form-input-control" value="{{draft_propellant.specificHeatRatio}}" placeholder="1,32" required>
        </div>

        <div class="form-group-block">
          <label class="input-caption-label">КРАТКАЯ ИНФОРМАЦИЯ</label>
          <textarea name="short_description" class="form-textarea-control" placeholder="Описание термодинамических свойств">{{draft_propellant.shortDescription}}</textarea>
        </div>

        <div class="draft-actions-container">
          <button type="submit" class="btn-primary-action">Опубликовать</button>
        </div>
      </form>

      {{else}}
      <div class="screen-header-block">
        <div class="screen-title-row">
          <h1 class="screen-title">Новое рабочее тело</h1>
          <span class="badge-draft-pill">НОВЫЙ</span>
        </div>
        <p class="screen-subtitle">Укажите название и прикрепите медиафайлы для создания черновика.</p>
      </div>

      <form method="POST" action="/propellants/draft" class="draft-form-block">
        <div class="section-caption-red">МЕДИАФАЙЛЫ</div>

        <div class="media-input-group">
          <div class="media-subcaption">ФОТО</div>
          <label class="media-select-card" for="draftPhotoInput">
            <input type="file" id="draftPhotoInput" name="photo" accept="image/*" class="media-hidden-file-input">
            <div class="media-select-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="3"/>
                <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/>
                <path d="M21 15l-5-5L5 21"/>
              </svg>
            </div>
            <div class="media-select-meta">
              <div class="media-select-title">Выбрать фото</div>
              <div class="media-select-hint">JPG, PNG или GIF</div>
            </div>
            <div class="media-select-plus">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </div>
          </label>
        </div>

        <div class="media-input-group">
          <div class="media-subcaption">ВИДЕО</div>
          <label class="media-select-card" for="draftVideoInput">
            <input type="file" id="draftVideoInput" name="video" accept="video/*" class="media-hidden-file-input">
            <div class="media-select-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="6" width="14" height="12" rx="3"/>
                <polygon points="16 10 22 7 22 17 16 14" fill="currentColor"/>
              </svg>
            </div>
            <div class="media-select-meta">
              <div class="media-select-title">Выбрать видео</div>
              <div class="media-select-hint">MP4 или MOV</div>
            </div>
            <div class="media-select-plus">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </div>
          </label>
        </div>

        <div class="section-caption-red">НАЗВАНИЕ УСЛУГИ</div>

        <div class="form-group-block">
          <label class="input-caption-label">НАЗВАНИЕ *</label>
          <input type="text" name="name" class="form-input-control" placeholder="Например: Ксенон Xe" required>
        </div>

        <div class="draft-actions-container">
          <button type="submit" class="btn-primary-action">Далее &gt;</button>
        </div>
      </form>
      {{/if}}
    </div>

    <nav class="bottom-tab-bar">
      <a href="/propellants/feed" class="tab-nav-item">
        <svg class="tab-nav-svg" viewBox="0 0 24 24">
          <path d="M12 2c-3.5 4-6 7.5-6 11a6 6 0 0 0 12 0c0-3.5-2.5-7-6-11z" />
          <path d="M12 18a2.5 2.5 0 0 1-2.5-2.5c0-1.5 1.5-2.5 2.5-4 1 1.5 2.5 2.5 2.5 4a2.5 2.5 0 0 1-2.5 2.5z" />
        </svg>
        <span>ЛЕНТА</span>
      </a>
      <a href="/propellants/draft" class="tab-nav-item active">
        <div class="tab-active-indicator"></div>
        <svg class="tab-nav-svg" viewBox="0 0 24 24">
          <line x1="12" y1="5" x2="12" y2="19" />
          <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        <span>ДОБАВИТЬ</span>
      </a>
      <a href="/propellants/catalog" class="tab-nav-item">
        <svg class="tab-nav-svg" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="3" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="12" y1="3" x2="12" y2="21" />
        </svg>
        <span>ПЛИТКА</span>
      </a>
    </nav>
  </div>
</body>
</html>